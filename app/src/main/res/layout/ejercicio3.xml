<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Ejercicio 3: Banderas y Layout Weight"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPantalla1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Pantalla 1: Azul / Blanco / Azul" />

    <Button
        android:id="@+id/btnPantalla2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Pantalla 2: Verde / Blanco / Verde" />

    <Button
        android:id="@+id/btnPantalla3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Pantalla 3: Cuadrícula Rojo / Blanco" />

</LinearLayout>