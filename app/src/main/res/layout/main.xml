<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:text="Boletín UT3 - Menú Principal"
        android:textSize="20sp"
        android:textStyle="bold" />


    <Button
        android:id="@+id/btnEjer1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Ejercicio 1: Validar URL" />


    <Button
        android:id="@+id/btnEjer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Ejercicio 2: Temporizador 10s" />


    <Button
        android:id="@+id/btnEjer3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Ejercicio 3: Layouts Anidados" />


    <Button
        android:id="@+id/btnEjer4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Ejercicio 4: Matriz FrameLayout (9 bloques)" />


    <Button
        android:id="@+id/btnEjer5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Ejercicio 5: Calculadora TableLayout" />


    <Button
        android:id="@+id/btnEjer6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="Ejercicio 6: Perfil ConstraintLayout" />

</LinearLayout>